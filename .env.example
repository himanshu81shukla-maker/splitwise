# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it's already in .gitignore.

# Firebase config (from Firebase Console > Project Settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key (for receipt scanning) — get one free at aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Cloudinary (free image hosting for receipt photos — no card required)
# From cloudinary.com dashboard: Cloud name + an unsigned upload preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
